# Local infrastructure
ANTHROPIC_API_KEY=
POSTGRES_URL=jdbc:postgresql://localhost:5432/jobportal
POSTGRES_USER=jobportal
# Required for local Docker Compose and Spring Boot. Choose a local password.
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTICSEARCH_URI=http://localhost:9200

# Authentication — generate a private value with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MS=28800000
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
APP_FRONTEND_URL=http://localhost:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_AUTH_SECURE_COOKIES=false

# The matching verified Google account becomes SUPER_ADMIN on its first sign-in.
# Set this true for that sign-in only, then switch it back to false.
SEED_ADMIN_ENABLED=false
ADMIN_EMAIL=
