# Host-only backup configuration. Copy this to /etc/jobz/backup.env on the
# production EC2 instance, fill the bucket name, then set mode 0600/root:root.
# It deliberately contains no AWS credentials: the EC2 instance profile does
# the authentication.
AWS_REGION=ap-south-1
BACKUP_S3_BUCKET=replace-with-your-globally-unique-backup-bucket
BACKUP_S3_PREFIX=postgres
