{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadPostgresBackupsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET_NAME/postgres/*"
    },
    {
      "Sid": "LocateBackupBucketAndManageMultipartUploads",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET_NAME"
    }
  ]
}
