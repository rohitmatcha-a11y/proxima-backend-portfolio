{
	# This local-only configuration intentionally serves plain HTTP. It is used
	# exclusively by scripts/verify-full-production-stack.sh and never by the
	# production deployment, where Caddy manages public HTTPS certificates.
	auto_https off
}

:80 {
	encode zstd gzip

	# Mirror the production browser-security baseline so the full-stack smoke
	# test validates headers. HSTS and upgrade-insecure-requests are intentionally
	# production-only because this local verifier serves plain HTTP.
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://accounts.google.com/gsi/ https://*.sentry.io; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; manifest-src 'self'"
	}

	@apiRoutes path /api/v1/* /api/backend/*
	header @apiRoutes >Cache-Control "no-store"

	@oauthRoutes path /api/v1/auth/* /api/backend/auth/*
	log_skip @oauthRoutes
	log {
		output stdout
		format json
	}

	@frontendApi path /api/backend/*
	handle @frontendApi {
		uri replace /api/backend /api/v1
		reverse_proxy backend:8080
	}

	@backendApi path /api/v1/*
	handle @backendApi {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:3000
	}
}
