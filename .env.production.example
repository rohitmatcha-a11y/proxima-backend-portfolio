# Public domain (without https://). DNS must point here before starting Caddy.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Keep this path when the two repositories are cloned as sibling folders.
FRONTEND_BUILD_CONTEXT=../proxima-frontend

# Human-readable release identifier shown by health/info endpoints (for example, a Git commit).
APP_VERSION=

# Database — create a long random password for production.
POSTGRES_DB=jobportal
POSTGRES_USER=jobportal
POSTGRES_PASSWORD=

# Application secrets — do not reuse local values.
# Generate with: openssl rand -base64 48
APP_AUTH_JWT_SECRET=
ANTHROPIC_API_KEY=

# OAuth credentials registered for the production domain.
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional frontend error monitoring. Keep source-map upload settings in CI/CD
# where possible; none of these values belong in Git.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Bootstrap exactly one SUPER_ADMIN through their verified Google account.
# Set true only for the first production sign-in, then set false and redeploy.
APP_AUTH_BOOTSTRAP_ADMIN_ENABLED=false
APP_AUTH_BOOTSTRAP_ADMIN_EMAIL=
