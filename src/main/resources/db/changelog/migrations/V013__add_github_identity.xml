<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="V013-add-github-identity" author="proxima">
        <addColumn tableName="app_users">
            <column name="github_subject" type="VARCHAR(255)"/>
        </addColumn>
        <addUniqueConstraint tableName="app_users"
                             columnNames="github_subject"
                             constraintName="uq_app_users_github_subject"/>
    </changeSet>
</databaseChangeLog>
