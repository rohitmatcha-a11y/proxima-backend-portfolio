<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="011-enforce-job-idempotency" author="codex">
        <addNotNullConstraint tableName="jobs" columnName="external_id" columnDataType="VARCHAR(255)"/>
        <addUniqueConstraint tableName="jobs"
                             columnNames="company_id,external_id"
                             constraintName="uk_jobs_company_external_id"/>
    </changeSet>
</databaseChangeLog>
